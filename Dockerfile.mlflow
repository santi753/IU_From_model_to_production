# Use official Python runtime as base image
# Match the local development environment version
FROM python:3.12-slim

# Set working directory in container
WORKDIR /mlflow

# Install MLflow
RUN pip install --no-cache-dir mlflow

# Create directories for backend store and artifacts
RUN mkdir -p /mlflow/mlruns /mlflow/mlflow-db

# Expose MLflow UI port
EXPOSE 5000

# Set environment variables for MLflow
ENV MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow-db/mlflow.db
ENV MLFLOW_ARTIFACTS_DESTINATION=/mlflow/mlruns

# Run MLflow server
# - backend-store-uri: SQLite database for experiment/run/model registry metadata
# - default-artifact-root: Local directory for storing artifacts
# - host: Listen on all interfaces (required for Docker container access)
# - port: MLflow UI port
# - serve-artifacts: Enable artifact serving through the tracking server
CMD ["mlflow", "server", \
    "--backend-store-uri", "sqlite:////mlflow/mlflow-db/mlflow.db", \
    "--default-artifact-root", "/mlflow/mlruns", \
    "--host", "0.0.0.0", \
    "--port", "5000", \
    "--serve-artifacts"]