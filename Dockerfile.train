# Use official Python runtime as base image
# Match the local development environment version
FROM python:3.12-slim

# Set working directory in container
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire repository
COPY . .

# Set default environment variables (can be overridden at runtime)
# These match the defaults in train_and_register.py
ENV MODEL_NAME=fraud_detector
ENV MLFLOW_TRACKING_URI=sqlite:///mlflow.db
ENV MLFLOW_ARTIFACT_LOCATION=./mlruns
ENV DECISION_THRESHOLD=0.640
ENV DATA_PATH=/app/data/data_raw.csv

# Run the training script
CMD ["python", "mlops/train_and_register.py"]